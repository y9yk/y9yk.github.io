---
import type { Post } from '../lib/posts';
interface Props { post: Post; eager?: boolean }
const { post, eager = false } = Astro.props;
---
<span class="post-cover">
  {post.cover
    ? <img src={post.cover} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <span class="post-cover-fallback" aria-hidden="true"></span>}
</span>
