---
import Shell from '../layouts/Shell.astro';
import Discussion from '../components/Discussion.astro';
import { posts, dateLabel, type Post } from '../lib/posts';

export function getStaticPaths() {
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = post.entry;
const arrow = (d: string) => `<svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="${d}"/></svg>`;
---
<Shell title={post.title} description={post.description} image={post.cover} type="article">
  <article class="article">
    <header class="article-head">
      <a class="back-link" href="/blog/"><Fragment set:html={arrow('M15 5l-7 7 7 7')} /><span>전체 글</span></a>
      <p class="post-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span>{post.readingMinutes}분 분량</span></p>
      <h1>{post.title}</h1>
      <p class="article-lede">{post.description}</p>
    </header>

    <div class="article-main">
      <div class="prose"><Content /></div>
      <Discussion />
    </div>

    {(newer || older) && (
      <nav class="post-pager" aria-label="다른 글">
        {older ? <a class="pager-card" href={older.href} rel="prev"><span class="pager-label"><Fragment set:html={arrow('M15 5l-7 7 7 7')} />이전 글</span><span class="pager-title">{older.title}</span><span class="pager-summary">{older.description}</span></a> : <span />}
        {newer ? <a class="pager-card pager-next" href={newer.href} rel="next"><span class="pager-label">다음 글<Fragment set:html={arrow('M9 5l7 7-7 7')} /></span><span class="pager-title">{newer.title}</span><span class="pager-summary">{newer.description}</span></a> : <span />}
      </nav>
    )}
  </article>
</Shell>
