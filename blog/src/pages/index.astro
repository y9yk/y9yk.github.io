---
import Shell from '../layouts/Shell.astro';
import PostCover from '../components/PostCover.astro';
import { posts, dateLabel } from '../lib/posts';

---
<Shell title="Blog" description="데이터 중심 어플리케이션들을 만들며 만난 문제들과 AI를 쓰며 달라진 일들을 기록합니다." image={posts[0]?.cover}>
  <section class="hero blog-hero" aria-labelledby="blog-title">
    <h1 id="blog-title" class="blog-intro">데이터 중심 어플리케이션들을 만들며 만난 문제들과<br />AI를 쓰며 달라진 일들을 기록합니다.</h1>
  </section>

  <section class="section blog-archive" aria-label="전체 글">
    <ol class="post-list">
      {posts.map((post, index) => (
        <li>
          <a class="post-row" href={post.href}>
            <span class="post-row-body">
              <span class="post-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span>{post.readingMinutes}분</span></span>
              <span class="post-row-title">{post.title}</span>
              <span class="post-row-summary">{post.description}</span>
            </span>
            <PostCover post={post} eager={index < 2} />
          </a>
        </li>
      ))}
    </ol>
  </section>
</Shell>
